    "environment-variables",
    "configuration-drift",
    "secret-redaction",
    "validation",
    "ci",
    "cli"
  ],
  "author": "Baris Sozudogru",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3"
  }
